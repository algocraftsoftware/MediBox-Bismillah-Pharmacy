{
  "name": "medibox",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-Tenant Pharmacy ERP — backend (Express/Prisma) + frontend (Next.js)",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "seed": "pnpm --filter medibox-backend seed",
    "import:medicines": "pnpm --filter medibox-backend import:medicines",
    "db:push": "pnpm --filter medibox-backend db:push"
  }
}
