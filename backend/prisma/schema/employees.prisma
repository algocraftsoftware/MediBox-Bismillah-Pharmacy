// =======================================================
// SHOP LEVEL — EMPLOYEES & SALARY
// =======================================================

model Employee {
  id        Int       @id @default(autoincrement())
  shopId    Int
  shop      Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  name      String
  address   String?
  mobile    String
  age       Int?
  education String?
  // Monthly gross salary of the employee — the default amount for a salary payment.
  salary    Float     @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  salaries EmployeeSalary[]

  @@index([shopId])
}

model EmployeeSalary {
  id         Int          @id @default(autoincrement())
  employeeId Int
  employee   Employee     @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  shopId     Int
  shop       Shop         @relation(fields: [shopId], references: [id], onDelete: Cascade)
  // The month this payment belongs to, as "YYYY-MM" (e.g. "2026-08").
  month      String
  // Amount actually paid out for that month.
  amount     Float        @default(0)
  status     SalaryStatus @default(UNPAID)
  paidAt     DateTime?
  remarks    String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@unique([employeeId, month])
  @@index([shopId, month])
}
