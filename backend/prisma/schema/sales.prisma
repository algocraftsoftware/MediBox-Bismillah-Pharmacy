// A payment taken against an invoice's outstanding due, after the sale itself.
//
// Receiving a due used to only bump the invoice's own paid* columns, which are
// dated by the sale. A payment collected today against last week's invoice
// therefore landed in last week's takings and was invisible in today's — the
// money came in, and no screen showed it. Each collection is now its own row,
// stamped when it happened and split the way it was taken, so a day's
// collection can be reported on the day it actually occurred.
//
// The invoice's paid* columns are still updated as before: they remain the
// running state of that invoice.
model DuePayment {
  id                Int       @id @default(autoincrement())
  shopId            Int
  shop              Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  storeId           Int
  store             Store     @relation(fields: [storeId], references: [id])
  saleId            Int
  sale              Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)

  amount            Float
  paidCash          Float     @default(0)
  paidMobileBanking Float     @default(0)
  paidCard          Float     @default(0)

  collectedById     Int
  collectedBy       ShopAdmin @relation(fields: [collectedById], references: [id])
  createdAt         DateTime  @default(now())

  @@index([shopId, createdAt])
  @@index([storeId, createdAt])
  @@index([saleId])
}
