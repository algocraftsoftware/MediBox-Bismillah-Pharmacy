DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/medibox?schema=public"

JWT_SECRET="change-this-to-a-long-random-string"

PORT=5000

# Comma-separated list of origins allowed to call this API. Leave unset to
# allow all origins (fine for local dev). In production, set this to your
# deployed frontend URL, e.g.:
# CORS_ORIGIN="https://medi-box-two.vercel.app"
CORS_ORIGIN=

# Cloudinary (used for shop logo uploads). Optional — if unset, logos fall
# back to base64 data URIs stored in the database.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
